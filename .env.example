# --- Proveedor activo: openai | anthropic | gemini ---
LLM_PROVIDER=gemini

# --- API Keys ---
GEMINI_API_KEY=tu-clave-de-gemini
OPENAI_API_KEY=sk-tu-clave-de-openai
ANTHROPIC_API_KEY=sk-ant-tu-clave-de-anthropic

# --- Parámetros del modelo ---
# LLM_MODEL=gemini-3.6-flash      # openai: gpt-4o-mini | anthropic: claude-3-5-haiku-latest
# LLM_TEMPERATURE=0.7             # rango válido: 0 a 2
# LLM_MAX_TOKENS=1024             # nro > 0
# LLM_TOP_P=1.0                   # rango válido: (0, 1]
